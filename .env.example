# Copy to .env (or set in your host's dashboard) — every variable is optional.

# Port to listen on (default 3000)
# PORT=3000

# Public base URL of the deployed site (used in Stripe redirect URLs)
# APP_URL=https://linksentry.app

# Google Safe Browsing v4 — adds blocklist checks to every scan (free key)
# https://console.cloud.google.com → enable "Safe Browsing API"
# GSB_API_KEY=

# URLhaus (abuse.ch) — adds malware-host reputation checks (free key)
# https://auth.abuse.ch → register, create an Auth-Key
# URLHAUS_API_KEY=

# Stripe — enables real Pro-plan checkout (waitlist mode when unset)
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_PRICE_ID=price_...        # recurring $9/mo price for Pro
# STRIPE_WEBHOOK_SECRET=whsec_...  # webhook endpoint: POST /api/billing/webhook

# Comma-separated emails that automatically get the Pro plan (owner/testing)
# PRO_EMAILS=you@example.com

# Comma-separated emails that can access the owner admin panel at /admin
# ADMIN_EMAILS=you@example.com

# Where the SQLite database lives (default ./data)
# DATA_DIR=/var/data
